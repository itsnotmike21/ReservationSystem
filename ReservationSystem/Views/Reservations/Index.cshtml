@model List<Reservation>

<h1>Reservations</h1>

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Date</th>
        <th>People</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Name</td>
            <td>@r.Date.ToShortDateString()</td>
            <td>@r.PeopleCount</td>
        </tr>
    }
    </tbody>
</table>