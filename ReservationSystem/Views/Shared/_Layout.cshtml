@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="pl" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - maravillosas reservas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        :root {
            --accent: #00eaff;
            --bg-dark: #0d0f12;
            --text-dark: #e6e6e6;
            --card-dark: rgba(255,255,255,0.05);
            --bg-light: #f2f2f7;
            --text-light: #111;
            --card-light: #ffffff;
        }

        [data-theme="dark"] {
            --bg: var(--bg-dark);
            --text: var(--text-dark);
            --card: var(--card-dark);
            --navbar-bg: rgba(0,0,0,0.7);
            --navbar-border: transparent;
        }

        [data-theme="light"] {
            --bg: var(--bg-light);
            --text: var(--text-light);
            --card: var(--card-light);
            --navbar-bg: #ffffff;
            --navbar-border: #ddd;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Montserrat', sans-serif;
            letter-spacing: .3px;
            transition: background .3s, color .3s;
        }

        .navbar {
            background: var(--navbar-bg);
            border-bottom: 1px solid var(--navbar-border);
            backdrop-filter: blur(10px);
            padding: 14px 0;
        }

        .navbar-brand {
            font-size: 1.4rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--accent) !important;
            letter-spacing: 1px;
        }

        .nav-link {
            color: var(--text) !important;
            opacity: .85;
            font-weight: 500;
        }

        .nav-link:hover {
            opacity: 1;
            color: var(--accent) !important;
        }

        .theme-toggle {
            cursor: pointer;
            color: var(--accent);
            font-size: 1.4rem;
            margin-left: 20px;
        }

        .card {
            background: var(--card);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid rgba(255,255,255,0.08);
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.25);
        }

        footer {
            margin-top: 40px;
            padding: 20px 0;
            text-align: center;
            opacity: .6;
        }
    </style>
</head>

<body>
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="/">maravillosas reservas</a>

        <div class="theme-toggle" onclick="toggleTheme()">🌓</div>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto">

                <li class="nav-item"><a class="nav-link" href="/">Strona główna</a></li>

                @if (HttpContextAccessor.HttpContext.Session.GetInt32("UserId") != null)
                {
                    <li class="nav-item"><a class="nav-link" href="/Reservations">Rezerwacje</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Objects">Obiekty</a></li>

                    @if (HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Admin")
                    {
                        <li class="nav-item"><a class="nav-link" href="/Users">Użytkownicy</a></li>
                    }

                    <li class="nav-item"><a class="nav-link" href="/Login/Logout">Wyloguj</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" href="/Login">Logowanie</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Register">Rejestracja</a></li>
                }

            </ul>
        </div>
    </div>
</nav>

<main class="container mt-4">
    @RenderBody()
</main>

<footer>
    © @DateTime.Now.Year grupa "super grupa"
</footer>

<script>
    const html = document.documentElement;

    const savedTheme = localStorage.getItem("theme");
    if (savedTheme) {
        html.dataset.theme = savedTheme;
    }

    function toggleTheme() {
        const newTheme = html.dataset.theme === "dark" ? "light" : "dark";
        html.dataset.theme = newTheme;
        localStorage.setItem("theme", newTheme);
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>