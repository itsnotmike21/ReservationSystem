@model IEnumerable<ReservationSystem.Models.Facility>

@{
    ViewData["Title"] = "Obiekty";
}

<h1 class="mb-4">Dostępne obiekty</h1>

<div class="row row-cols-1 row-cols-md-3 g-4">

    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">

                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" />
                }
                else
                {
                    <img src="/images/no-image.png" class="card-img-top" style="height: 200px; object-fit: cover;" />
                }

                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Description</p>
                    <p><strong>Cena:</strong> @item.Price zł / godz.</p>
                    <p><strong>Rozmiar:</strong> @item.Size m²</p>
                    <p><strong>Max osób:</strong> @item.Occupancy</p>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    
                    @if (Context.Session.GetString("UserRole") == "User")
                    {
                        <div>
                            <a asp-controller="Reservations" asp-action="Create" asp-route-facilityId="@item.Id" class="btn btn-primary">
                                Zarezerwuj 
                                </a>
                        </div>
                    }

                    @if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <div>
                            <a asp-controller="Reservations" asp-action="Create" asp-route-facilityId="@item.Id" class="btn btn-primary">
                                Zarezerwuj
                                </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edytuj</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Usuń</a>
                        </div>
                    }
                </div>

            </div>
        </div>
    }

</div>